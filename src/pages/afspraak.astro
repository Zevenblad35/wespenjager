---
import Base from '../layouts/Base.astro';
---
<Base
  title="Afspraak inplannen | Wespenfixer.nl"
  description="Plan een afspraak in met Joost van Wespenfixer.nl voor professionele wespenbestrijding. Kies uw voorkeursdatum en tijdvak — Joost bevestigt zo snel mogelijk."
  canonical="https://wespenfixer.nl/afspraak"
>
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Afspraak maken</span>
    <h1>Plan een <span class="text-yellow">afspraak</span> in</h1>
    <p class="lead">Vul uw gegevens in en kies een voorkeursdatum. Joost bevestigt de afspraak zo snel mogelijk — meestal dezelfde dag nog.</p>
  </div>
</section>
<div class="wasp-stripe"></div>

<section class="section">
  <div class="container">
    <div class="afspraak-layout">

      <div class="form-wrap">
        <!-- Progress indicator -->
        <div class="progress-bar" id="progress">
          <div class="progress-step active" data-step="1">
            <div class="step-circle">1</div>
            <span>Uw gegevens</span>
          </div>
          <div class="progress-line"></div>
          <div class="progress-step" data-step="2">
            <div class="step-circle">2</div>
            <span>Voorkeursdatum</span>
          </div>
          <div class="progress-line"></div>
          <div class="progress-step" data-step="3">
            <div class="step-circle">✓</div>
            <span>Bevestiging</span>
          </div>
        </div>

        <!-- Step 1: Gegevens -->
        <div class="form-step active" id="step1">
          <h2>Stap 1 — Uw gegevens</h2>
          <p class="step-intro">Vul uw contactgegevens in zodat Joost contact met u kan opnemen.</p>
          <div class="form-grid">
            <div class="field full">
              <label for="naam">Naam *</label>
              <input type="text" id="naam" name="naam" placeholder="Voor- en achternaam" required />
            </div>
            <div class="field">
              <label for="telefoon">Telefoonnummer *</label>
              <input type="tel" id="telefoon" name="telefoon" placeholder="06 12345678" required />
            </div>
            <div class="field">
              <label for="email">E-mailadres *</label>
              <input type="email" id="email" name="email" placeholder="uw@email.nl" required />
            </div>
            <div class="field full">
              <label for="adres">Adres *</label>
              <input type="text" id="adres" name="adres" placeholder="Straat en huisnummer" required />
            </div>
            <div class="field small">
              <label for="postcode">Postcode *</label>
              <input type="text" id="postcode" name="postcode" placeholder="1234 AB" required maxlength="7" />
            </div>
            <div class="field">
              <label for="woonplaats">Woonplaats *</label>
              <input type="text" id="woonplaats" name="woonplaats" placeholder="Nijverdal" required />
            </div>
            <div class="field full">
              <label for="omschrijving">Omschrijving probleem</label>
              <textarea id="omschrijving" name="omschrijving" rows="3" placeholder="Beschrijf kort het wespenprobleem en de locatie van het nest..."></textarea>
            </div>
          </div>
          <div class="step-actions">
            <button class="btn btn-primary" id="toStep2">Volgende stap →</button>
          </div>
        </div>

        <!-- Step 2: Voorkeursdatum -->
        <div class="form-step" id="step2">
          <h2>Stap 2 — Voorkeursdatum</h2>
          <p class="step-intro">Kies twee voorkeursdatums en een tijdvak. Joost bevestigt welke datum het beste uitkomt.</p>

          <div class="datum-block">
            <h3>1e voorkeursdatum</h3>
            <div class="datum-row">
              <div class="field">
                <label for="datum1">Datum *</label>
                <input type="date" id="datum1" name="datum1" required />
              </div>
              <div class="field">
                <label>Tijdvak *</label>
                <div class="tijdvak-group" id="tijdvak1">
                  <label class="tijdvak-option">
                    <input type="radio" name="tijdvak1" value="ochtend" />
                    <span class="tijdvak-label">
                      <span class="tijdvak-icon">🌅</span>
                      <strong>Ochtend</strong>
                      <small>09:00 – 12:00</small>
                    </span>
                  </label>
                  <label class="tijdvak-option">
                    <input type="radio" name="tijdvak1" value="middag" />
                    <span class="tijdvak-label">
                      <span class="tijdvak-icon">☀️</span>
                      <strong>Middag</strong>
                      <small>12:00 – 17:00</small>
                    </span>
                  </label>
                  <label class="tijdvak-option">
                    <input type="radio" name="tijdvak1" value="avond" />
                    <span class="tijdvak-label">
                      <span class="tijdvak-icon">🌆</span>
                      <strong>Avond</strong>
                      <small>17:00 – 20:00</small>
                    </span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="datum-block">
            <h3>2e voorkeursdatum</h3>
            <div class="datum-row">
              <div class="field">
                <label for="datum2">Datum *</label>
                <input type="date" id="datum2" name="datum2" required />
              </div>
              <div class="field">
                <label>Tijdvak *</label>
                <div class="tijdvak-group" id="tijdvak2">
                  <label class="tijdvak-option">
                    <input type="radio" name="tijdvak2" value="ochtend" />
                    <span class="tijdvak-label">
                      <span class="tijdvak-icon">🌅</span>
                      <strong>Ochtend</strong>
                      <small>09:00 – 12:00</small>
                    </span>
                  </label>
                  <label class="tijdvak-option">
                    <input type="radio" name="tijdvak2" value="middag" />
                    <span class="tijdvak-label">
                      <span class="tijdvak-icon">☀️</span>
                      <strong>Middag</strong>
                      <small>12:00 – 17:00</small>
                    </span>
                  </label>
                  <label class="tijdvak-option">
                    <input type="radio" name="tijdvak2" value="avond" />
                    <span class="tijdvak-label">
                      <span class="tijdvak-icon">🌆</span>
                      <strong>Avond</strong>
                      <small>17:00 – 20:00</small>
                    </span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="voorkeur-note">
            <span>ℹ️</span>
            <p>Dit zijn <strong>voorkeursdatums</strong>. Joost bevestigt de definitieve afspraak telefonisch of via WhatsApp.</p>
          </div>

          <div class="step-actions">
            <button class="btn btn-outline-dark" id="toStep1Back">← Terug</button>
            <button class="btn btn-primary" id="toStep3">Afspraak aanvragen →</button>
          </div>
        </div>

        <!-- Step 3: Bevestiging -->
        <div class="form-step" id="step3">
          <div class="confirmation">
            <div class="confirmation-icon">✅</div>
            <h2>Aanvraag verstuurd!</h2>
            <p>Bedankt voor uw aanvraag. Joost neemt zo snel mogelijk contact met u op om de afspraak te bevestigen.</p>
            <div class="confirmation-summary" id="summary"></div>
            <div class="confirmation-wa">
              <p>Wilt u direct contact?</p>
              <a href="https://wa.me/31683392065" target="_blank" rel="noopener" class="btn btn-wa">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                App Joost op WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Aside -->
      <aside class="afspraak-aside">
        <div class="aside-card">
          <h3>Liever direct contact?</h3>
          <a href="https://wa.me/31683392065" target="_blank" rel="noopener" class="btn btn-wa" style="width:100%;justify-content:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            06 83392065
          </a>
          <a href="tel:+31683392065" class="aside-tel">Of bel: 06 83392065</a>
        </div>
        <div class="aside-info">
          <h4>Wat u kunt verwachten</h4>
          <ul>
            <li>⚡ Joost reageert dezelfde dag</li>
            <li>📅 Ma–Za: 09:00 – 20:00</li>
            <li>📍 Heel Twente & Overijssel</li>
            <li>🛡️ Gecertificeerde bestrijding</li>
            <li>✅ Transparante prijsopgave</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  // Set minimum date to today
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('datum1')?.setAttribute('min', today);
  document.getElementById('datum2')?.setAttribute('min', today);

  // Step navigation
  function showStep(n) {
    document.querySelectorAll('.form-step').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.progress-step').forEach((s, i) => {
      s.classList.toggle('active', i < n);
      s.classList.toggle('done', i < n - 1);
    });
    document.getElementById('step' + n)?.classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function validateStep1() {
    const fields = ['naam', 'telefoon', 'email', 'adres', 'postcode', 'woonplaats'];
    let ok = true;
    fields.forEach(id => {
      const el = document.getElementById(id);
      if (!el?.value.trim()) {
        el?.classList.add('error');
        ok = false;
      } else {
        el?.classList.remove('error');
      }
    });
    return ok;
  }

  function validateStep2() {
    const d1 = document.getElementById('datum1')?.value;
    const d2 = document.getElementById('datum2')?.value;
    const t1 = document.querySelector('input[name="tijdvak1"]:checked');
    const t2 = document.querySelector('input[name="tijdvak2"]:checked');
    if (!d1 || !t1) { alert('Vul datum en tijdvak in voor uw 1e voorkeur.'); return false; }
    if (!d2 || !t2) { alert('Vul datum en tijdvak in voor uw 2e voorkeur.'); return false; }
    return true;
  }

  function buildSummary() {
    const naam = document.getElementById('naam')?.value;
    const tel = document.getElementById('telefoon')?.value;
    const adres = document.getElementById('adres')?.value;
    const pc = document.getElementById('postcode')?.value;
    const wp = document.getElementById('woonplaats')?.value;
    const d1 = document.getElementById('datum1')?.value;
    const t1 = document.querySelector('input[name="tijdvak1"]:checked')?.value;
    const d2 = document.getElementById('datum2')?.value;
    const t2 = document.querySelector('input[name="tijdvak2"]:checked')?.value;

    const fmt = d => { const p = d.split('-'); return `${p[2]}-${p[1]}-${p[0]}`; };

    document.getElementById('summary').innerHTML = `
      <div class="summary-row"><span>Naam:</span><strong>${naam}</strong></div>
      <div class="summary-row"><span>Telefoon:</span><strong>${tel}</strong></div>
      <div class="summary-row"><span>Adres:</span><strong>${adres}, ${pc} ${wp}</strong></div>
      <div class="summary-row"><span>1e voorkeur:</span><strong>${fmt(d1)} — ${t1}</strong></div>
      <div class="summary-row"><span>2e voorkeur:</span><strong>${fmt(d2)} — ${t2}</strong></div>
    `;
  }

  document.getElementById('toStep2')?.addEventListener('click', () => {
    if (validateStep1()) showStep(2);
  });
  document.getElementById('toStep1Back')?.addEventListener('click', () => showStep(1));
  document.getElementById('toStep3')?.addEventListener('click', () => {
    if (validateStep2()) { buildSummary(); showStep(3); }
  });

  // Tijdvak visual selection
  document.querySelectorAll('.tijdvak-option input').forEach(radio => {
    radio.addEventListener('change', () => {
      const group = radio.closest('.tijdvak-group');
      group?.querySelectorAll('.tijdvak-option').forEach(o => o.classList.remove('selected'));
      radio.closest('.tijdvak-option')?.classList.add('selected');
    });
  });
</script>
</Base>

<style>
  .page-hero { background: var(--black); color: var(--white); padding: 72px 0 56px; }
  .page-hero .eyebrow { color: var(--yellow); }
  .page-hero h1 { color: var(--white); margin: 12px 0 16px; }
  .page-hero .lead { color: rgba(255,255,255,0.8); }

  .afspraak-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 48px;
    align-items: start;
  }

  /* PROGRESS */
  .progress-bar {
    display: flex;
    align-items: center;
    margin-bottom: 40px;
  }
  .progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0.35;
    transition: opacity 0.3s;
  }
  .progress-step.active, .progress-step.done { opacity: 1; }
  .step-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ddd;
    color: #666;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s, color 0.3s;
  }
  .progress-step.active .step-circle { background: var(--yellow); color: var(--black); }
  .progress-step.done .step-circle { background: #25D366; color: white; }
  .progress-step span { font-size: 0.75rem; font-weight: 600; color: #666; white-space: nowrap; }
  .progress-step.active span { color: var(--black); }
  .progress-line { flex: 1; height: 2px; background: #ddd; margin: 0 12px; margin-bottom: 22px; }

  /* FORM */
  .form-step { display: none; }
  .form-step.active { display: block; }
  .form-step h2 { margin-bottom: 8px; }
  .step-intro { color: #666; margin-bottom: 28px; }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field.full { grid-column: 1 / -1; }
  .field.small { max-width: 140px; }
  .field label { font-weight: 700; font-size: 0.88rem; color: var(--black); }
  .field input, .field textarea, .field select {
    padding: 12px 14px;
    border: 2px solid #ddd;
    border-radius: var(--radius);
    font-size: 0.95rem;
    font-family: var(--font-body);
    transition: border-color 0.15s;
    background: var(--white);
  }
  .field input:focus, .field textarea:focus {
    outline: none;
    border-color: var(--yellow);
  }
  .field input.error { border-color: #e53; }
  .field textarea { resize: vertical; min-height: 80px; }

  /* DATUM BLOCKS */
  .datum-block {
    background: var(--grey);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 20px;
    border-left: 4px solid var(--yellow);
  }
  .datum-block h3 { font-size: 1rem; margin-bottom: 16px; color: var(--black); }
  .datum-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 20px;
    align-items: start;
  }

  /* TIJDVAK */
  .tijdvak-group { display: flex; gap: 10px; flex-wrap: wrap; }
  .tijdvak-option {
    cursor: pointer;
    flex: 1;
    min-width: 90px;
  }
  .tijdvak-option input { display: none; }
  .tijdvak-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 8px;
    border: 2px solid #ddd;
    border-radius: var(--radius-lg);
    background: var(--white);
    text-align: center;
    transition: all 0.15s;
    cursor: pointer;
  }
  .tijdvak-option:hover .tijdvak-label { border-color: var(--yellow); }
  .tijdvak-option.selected .tijdvak-label {
    border-color: var(--yellow);
    background: var(--yellow-light);
  }
  .tijdvak-icon { font-size: 1.4rem; }
  .tijdvak-label strong { font-size: 0.88rem; display: block; }
  .tijdvak-label small { font-size: 0.75rem; color: #888; }

  .voorkeur-note {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--blue-light);
    border-left: 4px solid var(--blue);
    padding: 14px 16px;
    border-radius: var(--radius);
    font-size: 0.9rem;
    margin: 24px 0;
  }
  .voorkeur-note p { color: #333; margin: 0; }

  .step-actions {
    display: flex;
    gap: 16px;
    margin-top: 28px;
  }
  .btn-outline-dark {
    background: transparent;
    color: var(--black);
    border: 2px solid #ccc;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: var(--radius);
    cursor: pointer;
    transition: all 0.15s;
  }
  .btn-outline-dark:hover { border-color: var(--black); }

  /* CONFIRMATION */
  .confirmation { text-align: center; padding: 40px 0; }
  .confirmation-icon { font-size: 4rem; margin-bottom: 16px; }
  .confirmation h2 { margin-bottom: 12px; }
  .confirmation > p { color: #555; max-width: 480px; margin: 0 auto 28px; }
  .confirmation-summary {
    background: var(--grey);
    border-radius: var(--radius-lg);
    padding: 20px 28px;
    text-align: left;
    max-width: 440px;
    margin: 0 auto 28px;
  }
  .summary-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid #e5e5e5;
    font-size: 0.9rem;
  }
  .summary-row span { color: #888; }
  .confirmation-wa p { color: #666; margin-bottom: 12px; font-size: 0.9rem; }

  /* ASIDE */
  .afspraak-aside { display: flex; flex-direction: column; gap: 20px; }
  .aside-card {
    background: var(--black);
    border-radius: var(--radius-lg);
    padding: 24px;
    color: var(--white);
  }
  .aside-card h3 { color: var(--yellow); margin-bottom: 16px; font-size: 1rem; }
  .aside-tel {
    display: block;
    text-align: center;
    color: rgba(255,255,255,0.5);
    font-size: 0.82rem;
    margin-top: 10px;
    text-decoration: none;
  }
  .aside-tel:hover { color: var(--yellow); }
  .aside-info {
    background: var(--grey);
    border-radius: var(--radius-lg);
    padding: 20px;
  }
  .aside-info h4 { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--grey-mid); margin-bottom: 12px; }
  .aside-info ul { list-style: none; }
  .aside-info li { padding: 8px 0; border-bottom: 1px solid #e5e5e5; font-size: 0.9rem; }

  @media (max-width: 800px) {
    .afspraak-layout { grid-template-columns: 1fr; }
    .datum-row { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
    .field.small { max-width: 100%; }
  }
</style>
