  .loc-article h2 { font-size: 1.4rem; margin: 36px 0 14px; padding-bottom: 8px; border-bottom: 2px solid var(--yellow); display: inline-block; }
  .loc-article p { color: #444; margin-bottom: 14px; }

  .numbered-list { margin: 16px 0 16px 4px; list-style: none; counter-reset: steps; }
  .numbered-list li {
    counter-increment: steps;
    padding: 12px 0 12px 48px;
    position: relative;
    border-bottom: 1px solid #eee;
    color: #444;
    font-size: 0.95rem;
  }
  .numbered-list li::before {
    content: counter(steps);
    position: absolute;
    left: 0;
    top: 12px;
    width: 28px;
    height: 28px;
    background: var(--yellow);
    color: var(--black);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.85rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* FAQ */
  .faq-local {
    border-bottom: 1px solid #eee;
    padding: 14px 0;
  }
  .faq-local summary {
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    font-size: 0.97rem;
    color: var(--black);
  }
  .faq-local summary::after { content: ' +'; color: var(--yellow-dark); }
  .faq-local[open] summary::after { content: ' −'; }
  .faq-local p { margin-top: 10px; color: #555; font-size: 0.92rem; }

