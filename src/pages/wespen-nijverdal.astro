  }

  /* ANSWER BLOCK - styled for AI parsability */
  .answer-block {
    background: var(--yellow-light);
    border-left: 4px solid var(--yellow);
    padding: 20px 24px;
    border-radius: var(--radius-lg);
    margin-bottom: 40px;
  }
  .answer-block h2 { font-size: 1.2rem; margin-bottom: 12px; }
